# albert-grabar.com — Apache/LiteSpeed settings (PlanetHoster)

Options -MultiViews -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) After checking that https://www.albert-grabar.com opens correctly,
  #    remove the "#" in front of the 6 lines below: one address only,
  #    https://www.albert-grabar.com (albert-grabar.com and albertgrabar.com redirect to it).
  #    Subdomains such as technoir.albert-grabar.com are not touched.
  # RewriteCond %{HTTP_HOST} ^(?:www\.)?albertgrabar\.com$ [NC,OR]
  # RewriteCond %{HTTP_HOST} ^albert-grabar\.com$ [NC]
  # RewriteRule ^ https://www.albert-grabar.com%{REQUEST_URI} [R=301,L]
  # RewriteCond %{HTTP_HOST} ^www\.albert-grabar\.com$ [NC]
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://www.albert-grabar.com%{REQUEST_URI} [R=301,L]

  # 2) Old TECH NOIR pages (still in Google) now live on technoir.albert-grabar.com
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(catalog|catalogue|register|login|logout|cart|panier|product|produit|profile|profil|account|compte|order|commande|checkout|admin|search|recherche|reset-password)(/.*)?$ https://technoir.albert-grabar.com/$1$2 [R=301,L,NC]

  # 3) Short addresses: /services opens /services.html
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

# Never serve the build configuration if it is uploaded by mistake
<FilesMatch "\.(json|mjs|md|scss|lock)$">
  Require all denied
</FilesMatch>
